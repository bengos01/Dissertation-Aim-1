}

@article{RN25,
   author = {Goldner, E. M. and Hsu, L. and Waraich, P. and Somers, J. M.},
   title = {Prevalence and incidence studies of schizophrenic disorders: a systematic review of the literature},
   journal = {Can J Psychiatry},

@article{RN5,
   author = {Cerqueira, R. O. and Ziebold, C. and Cavalcante, D. and Oliveira, G. and Vasquez, J. and Undurraga, J. and Gonzalez-Valderrama, A. and Nachar, R. and Lopez-Jaramillo, C. and Noto, C. and Crossley, N. and Gadelha, A.},
   title = {Differences of affective and non-affective psychoses in early intervention services from Latin America},

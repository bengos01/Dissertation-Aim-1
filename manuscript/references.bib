   year = {2004},
   type = {Journal Article}
}

@article{RN26,
   author = {Saha, S. and Chant, D. and Welham, J. and McGrath, J.},
   title = {A systematic review of the prevalence of schizophrenia},
   journal = {PLoS Med},
   volume = {2},

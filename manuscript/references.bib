@article{RN44,
   author = {Hjorthoj, C. and Sturup, A. E. and McGrath, J. J. and Nordentoft, M.},
   title = {Years of potential life lost and life expectancy in schizophrenia: a systematic review and meta-analysis},
   journal = {Lancet Psychiatry},
   volume = {4},

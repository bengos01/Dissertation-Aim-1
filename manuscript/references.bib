   year = {2005},
   type = {Journal Article}
}

@article{RN47,
   author = {van Os, J. and Krabbendam, L. and Myin-Germeys, I. and Delespaul, P.},
   title = {The schizophrenia envirome},
   journal = {Curr Opin Psychiatry},
   volume = {18},
   number = {2},

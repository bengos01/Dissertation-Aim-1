@article{RN51,
   author = {Santesteban-Echarri, O. and Paino, M. and Rice, S. and Gonzalez-Blanch, C. and McGorry, P. and Gleeson, J. and Alvarez-Jimenez, M.},
   title = {Predictors of functional recovery in first-episode psychosis: A systematic review and meta-analysis of longitudinal studies},

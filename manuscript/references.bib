@article{RN19,
   author = {Burns, J. K. and Esterhuizen, T.},
   title = {Poverty, inequality and the treated incidence of first-episode psychosis: an ecological study from South Africa},
   journal = {Soc Psychiatry Psychiatr Epidemiol},
   volume = {43},

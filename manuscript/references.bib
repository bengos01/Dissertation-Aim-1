@article{RN86,
   author = {Mascayano, F. and Burgos, J. and Hernandez, V. and Casanueva, R. and Yang, X. and Li, Z. and Sampat, P. and Munoz-Quezada, M. T. and Rojas-Navarro, S. and Rodriguez, K. and Stingone, J. and Yang, L. and Susser, E.},
   title = {Urbanicity, parental social deprivation, and risk of early psychosis in Chile: a national cohort study},
   journal = {Lancet Reg Health Am},
   volume = {52},
   pages = {101282},
   note = {Mascayano, Franco
Burgos, Javiera
Hernandez, Viviana
Casanueva, Rodrigo
Yang, Xinyu
Li, Zeyu
Sampat, Param
Munoz-Quezada, Maria Teresa

@article{RN87,
   author = {Andrysiak, N. K. and Chakraborty, P. and Beccia, A. L. and Charlton, B. M. and Reynolds, C. A.},
   title = {Inequities in eating disorder diagnoses in college students: An intersectional multilevel analysis of individual heterogeneity and discriminatory accuracy (MAIHDA)},
